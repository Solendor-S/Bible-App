{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@renderer/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  // Standalone check run by `npm run check-esv` under node's own type stripping,
  // which needs the explicit .ts import specifier the bundler config rejects.
  "exclude": ["src/**/*.selfcheck.ts"]
}
